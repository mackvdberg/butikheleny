      margin: 0px;
      line-height: 28px;
      color: {{ settings.blinkstock_TextColor }} !important;
      display: flex;
      align-items: center !important;
    }
    #BlinkingIcon_Stock .icon {
      position: relative;
      display: inline-block;
      vertical-align: text-bottom;
    }
    #BlinkingIcon_Stock .icon img {
      width: 12px;
      margin: 0px 0px 2px 6px;
      visibility:hidden;
    }
    #BlinkingIcon_Stock .icon{
    background-color:{{ settings.blinkstock_IconColor }};
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin: 0px 12px 0px 6px;
    left: 0px;
  }
  #BlinkingIcon_Stock .icon::before {
    content: " ";
    background-color: {{ settings.blinkstock_IconColor }};
    width: 26px;
    height: 26px;
    border-radius: 50%;
    margin: 0 auto;
    transition: all 0.5s;
    animation: mymove 2s infinite;
    position: absolute;
    top: -8px;
    left: -8px;
  }
  @keyframes mymove {
    0% {
        transform: scale(.35);
        box-shadow: 0 0 {{ settings.blinkstock_IconColor }};
        opacity: 0.4;
    }
    70%{
      transform: scale(.35);
      box-shadow: 0 0 0 10px {{ settings.blinkstock_IconColor }};
      opacity: 0.4;
    }
    100%{
        transform: scale(.35);
        box-shadow: 0 0 {{ settings.blinkstock_IconColor }};
        opacity: 0.4;
    }
  }
