{% doc %}
  @prompt
    Ik wil hier ook een custom liquid
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ settings.color_body_text | default: '#1c1d1d' }};
    font-family: {{ settings.type_base_font_family.family | default: 'sans-serif' }};
  }

  .ai-custom-liquid-{{ ai_gen_id }}:focus-within {
    outline-offset: 2px;
  }
{% endstyle %}

<div class="ai-custom-liquid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "Custom liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom liquid"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ],
  "tag": null,
  "class": "custom-liquid-block"
}
{% endschema %}