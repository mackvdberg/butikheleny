{% doc %}
  @prompt
    Ik wil hier een separator lijn
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-separator-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.vertical_spacing }}px auto;
    border: 0;
    border-top: {{ block.settings.thickness }}px {{ block.settings.line_style }} {{ block.settings.line_color }};
  }
{% endstyle %}

<hr class="ai-separator-{{ ai_gen_id }}" aria-hidden="true" {{ block.shopify_attributes }}>

{% schema %}
{
  "name": "Separator line",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#d0d0d0"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 9,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Separator line"
    }
  ],
  "tag": null,
  "class": "separator-line-block"
}
{% endschema %}