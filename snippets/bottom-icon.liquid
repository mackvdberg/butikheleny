<style>
#BlinkingGuaranteeIcon{
      margin: 0px 0px 14px 0px;
      line-height: 28px;
      color: {{ settings.blinkgua_TextColor }} !important;
      display: flex;
      align-items: center !important;
    }
    #BlinkingGuaranteeIcon .icon {
      position: relative;
      display: inline-block;
      vertical-align: text-bottom;
    }
    #BlinkingGuaranteeIcon .icon img {
      width: 12px;
      margin: 0px 0px 2px 6px;
      visibility:hidden;
    }
    #BlinkingGuaranteeIcon .icon{
    background-color:{{ settings.blinkgua_IconColor }};
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin: 0px 12px 0px 6px;
    left: 0px;
  }
  #BlinkingGuaranteeIcon .icon::before {
    content: " ";
    background-color: {{ settings.blinkgua_IconColor }};
    width: 26px;
    height: 26px;
    border-radius: 50%;
    margin: 0 auto;
    transition: all 0.5s;
    animation: mymove 2s infinite;
    position: absolute;
    top: -8px;
    left: -8px;
  }
  @keyframes mymove {
    0% {
        transform: scale(.35);
        box-shadow: 0 0 {{ settings.blinkgua_IconColor }};
        opacity: 0.4;
    }
    70%{
      transform: scale(.35);
      box-shadow: 0 0 0 10px {{ settings.blinkgua_IconColor }};
      opacity: 0.4;
    }
    100%{
        transform: scale(.35);
        box-shadow: 0 0 {{ settings.blinkgua_IconColor }};
        opacity: 0.4;
    }
  }
  .BlinkingGuaranteeText{
    display: inline-block;
    vertical-align: super;
    margin-left: 7px;
  }
</style>


<div id="BlinkingGuaranteeIcon" class="single-gurentee-item">
	<div class="icon">
        	<img src="//cdn.shopify.com/s/files/1/0759/0379/5515/files/Ibtisam_Bari_1.png?v=1708028025">
	</div>
	<div class="BlinkingGuaranteeText">
		<p style="margin:0px; font-size:17px;">{{ settings.blinkgua_text }}</p>
	</div>
  </div>